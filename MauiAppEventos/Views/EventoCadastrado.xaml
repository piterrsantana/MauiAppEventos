<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.EventoCadastrado"
             Title="Orçamento Emitido"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource White}">

    <!-- Layout principal da página -->
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="20"
                         Spacing="12">

        <!-- Exibe o nome do cliente -->
        <Label Text="{Binding NomeCliente, StringFormat='Contratante:  {0}'}"
               TextColor="{StaticResource CorPrincipal}"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap" />

        <!-- Exibe o tipo de evento escolhido -->
        <Label Text="{Binding TipoEvento, StringFormat='Categoria: {0}'}"
               TextColor="Gray"
               FontSize="16"
               HorizontalTextAlignment="Center"
               FontAttributes="Italic" />

        <!-- Mostra o salão selecionado -->
        <Frame BackgroundColor="Black"
               Padding="12"
               CornerRadius="8">
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="5">
                <Label Text="Espaço Reservado:"
                       TextColor="Gray"
                       FontAttributes="Bold" />
                <Label Text="{Binding LocalSalao}"
                       TextColor="White" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Tabela com quantidade de convidados e valores -->
        <Frame BackgroundColor="Black"
               Padding="12"
               CornerRadius="8">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto, Auto"
                  Padding="5"
                  RowSpacing="5">

                <!-- Cabeçalho da tabela -->
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Text="Público"
                       TextColor="Gray"
                       FontAttributes="Bold" />
                <Label Grid.Row="0"
                       Grid.Column="1"
                       Text="Quantidade"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray"
                       FontAttributes="Bold" />
                <Label Grid.Row="0"
                       Grid.Column="2"
                       Text="Valor Unit."
                       HorizontalTextAlignment="Center"
                       TextColor="Gray"
                       FontAttributes="Bold" />

                <!-- Dados dos convidados adultos -->
                <Label Grid.Row="1"
                       Grid.Column="0"
                       Text="Adultos"
                       TextColor="White" />
                <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding QntAdultos}"
                       HorizontalTextAlignment="Center"
                       TextColor="White" />
                <Label Grid.Row="1"
                       Grid.Column="2"
                       Text="{Binding CustoAdulto, StringFormat='{}{0:C}'}"
                       HorizontalTextAlignment="Center"
                       TextColor="LightBlue" />

                <!-- Dados dos convidados crianças -->
                <Label Grid.Row="2"
                       Grid.Column="0"
                       Text="Crianças"
                       TextColor="White" />
                <Label Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding QntCriancas}"
                       HorizontalTextAlignment="Center"
                       TextColor="White" />
                <Label Grid.Row="2"
                       Grid.Column="2"
                       Text="{Binding CustoCrianca, StringFormat='{}{0:C}'}"
                       HorizontalTextAlignment="Center"
                       TextColor="LightBlue" />
            </Grid>
        </Frame>

        <!-- Informações sobre o período da reserva -->
        <Frame BackgroundColor="Black"
               Padding="12"
               CornerRadius="8">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto"
                  Padding="5">

                <!-- Títulos das colunas -->
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Text="Data Início:"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />
                <Label Grid.Row="0"
                       Grid.Column="1"
                       Text="Data Término:"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />
                <Label Grid.Row="0"
                       Grid.Column="2"
                       Text="Reserva Salão:"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />

                <!-- Dados da reserva -->
                <Label Grid.Row="1"
                       Grid.Column="0"
                       Text="{Binding DataInicio, StringFormat='{}{0:dd/MM/yyyy}'}"
                       HorizontalTextAlignment="Center"
                       TextColor="White" />
                <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding DataTermino, StringFormat='{}{0:dd/MM/yyyy}'}"
                       HorizontalTextAlignment="Center"
                       TextColor="White" />
                <Label Grid.Row="1"
                       Grid.Column="2"
                       Text="{Binding DuracaoDias, StringFormat='{}{0} dias'}"
                       HorizontalTextAlignment="Center"
                       TextColor="White"
                       FontAttributes="Bold" />
            </Grid>
        </Frame>

        <!-- Exibe o valor total calculado -->
        <Frame BackgroundColor="Black"
               Padding="15"
               CornerRadius="8">
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="8">
                <Label Text="ORÇAMENTO TOTAL:"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />

                <Label Text="{Binding CustoTotal, StringFormat='{}{0:C}'}"
                       TextColor="LightGreen"
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Botão para retornar à tela de cadastro -->
        <Button Text="Voltar"
                Style="{StaticResource BotaoPadrao}"
                WidthRequest="220"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"
                Margin="0,10,0,0" />

    </VerticalStackLayout>
</ContentPage>