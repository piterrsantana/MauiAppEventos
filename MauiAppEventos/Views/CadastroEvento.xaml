<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.CadastroEvento"
             Title="Reserva de Buffet"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <!--Página de Apresentação do App-->
    <ScrollView>
        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                             Padding="15"
                             Spacing="10">

            <!--Cabeçalho da Tela Incial-->
            <Label Text="Buffet Gordon"
                   FontSize="32"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource CorPrincipal}"
                   FontAttributes="Bold" />

            <Label Text="Agendamento e Sistema de Orçamentos"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray"
                   Margin="0,0,0,10" />

            <!--Quadro para inserir as proximas Grades e solicitação de escolhas do usuário-->
            <Frame Padding="15"
                   BackgroundColor="Black"
                   CornerRadius="10">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Nome do Cliente / Contratante:"
                           TextColor="White" />

                    <!--Entry para inserir o nome do Contratante-->
                    <Entry x:Name="txt_nome"
                           Placeholder="Ex: Casamento de Juliana e Marcos"
                           BackgroundColor="White"
                           TextColor="Black" />

                    <Label Text="Tipo de Evento:"
                           TextColor="White" />

                    <Picker x:Name="pck_tipo"
                            Title="Selecione o tipo de celebração"
                            TitleColor="Gray"
                            BackgroundColor="White"
                            TextColor="Black">

                        <!--Picker para as opções de Eventos que o Buffet oferece-->
                        <!--Uso de array dentro do Picker para economia e clareza do código, por serem opções fixas-->
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Casamento</x:String>
                                <x:String>Aniversário de Casamento</x:String>
                                <x:String>Formatura</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Label Text="Escolha o Salão de Festas:"
                           TextColor="White" />

                    <Picker x:Name="pck_local"
                            Title="Selecione a Unidade"
                            TitleColor="Gray"
                            BackgroundColor="White"
                            TextColor="Black">

                        <!--Novamente uso do array de Strings-->
                        <Picker.ItemsSource>                            
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Mogi das Cruzes - SP (Sede Master)</x:String>
                                <x:String>Barueri - SP (Espaço Premium)</x:String>
                                <x:String>Guarulhos - SP (Salão Kids &amp; Festas)</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Label Text="Quantidade de Adultos:"
                           TextColor="White"
                           Margin="0,5,0,0" />

                    <Grid ColumnDefinitions="2*, 3*"
                          ColumnSpacing="10">

                        <Entry x:Name="txt_adultos"
                               Text="{Binding Source={x:Reference stp_adultos}, Path=Value, Mode=TwoWay}"
                               Keyboard="Numeric"
                               BackgroundColor="White"
                               TextColor="Black"
                               HorizontalTextAlignment="Center" />

                        <Stepper x:Name="stp_adultos"
                                 Minimum="1"
                                 Maximum="500"
                                 Increment="1"
                                 VerticalOptions="Center"
                                 BackgroundColor="White" />
                    </Grid>

                    <Label Text="Quantidade de Crianças:"
                           TextColor="White"
                           Margin="0,5,0,0" />

                    <Grid ColumnDefinitions="2*, 3*"
                          ColumnSpacing="10">

                        <Entry x:Name="txt_criancas"
                               Text="{Binding Source={x:Reference stp_criancas}, Path=Value, Mode=TwoWay}"
                               Keyboard="Numeric"
                               BackgroundColor="White"
                               TextColor="Black"
                               HorizontalTextAlignment="Center" />

                        <Stepper x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="150"
                                 Increment="1"
                                 VerticalOptions="Center"
                                 BackgroundColor="White" />
                    </Grid>

                    <Label Text="Período da Reserva (Uso do Espaço):"
                           TextColor="White"
                           FontAttributes="Bold"
                           Margin="0,5,0,0" />

                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="Center">

                        <Label Text="Início:"
                               VerticalOptions="Center"
                               TextColor="White" />

                        <DatePicker x:Name="dtpck_inicio"
                                    Format="dd/MM/yyyy"
                                    DateSelected="dtpck_inicio_DateSelected"
                                    BackgroundColor="White" />

                        <Label Text="Fim:"
                               VerticalOptions="Center"
                               TextColor="White" />

                        <DatePicker x:Name="dtpck_termino"
                                    Format="dd/MM/yyyy"
                                    BackgroundColor="White" />
                    </HorizontalStackLayout>

                    <Button Text="Gerar Orçamento Completo"
                            Style="{StaticResource BotaoPadrao}"
                            Clicked="Button_Clicked"
                            Margin="0,10,0,0" />
                    
                    <Button Text="Ver detalhes dos pacotes"
                            BackgroundColor="Gray"
                            TextColor="White"
                            Clicked="VerPacotes_Clicked" />

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

        

       
                
               
                
               

                    
                    
                    
